# MiniMax / MiniMax API credentials
# 从 https://platform.minimaxi.com/ 获取
MINIMAX_API_KEY=your_api_key_here
MINIMAX_GROUP_ID=optional_group_id

# TTS 配置
MINIMAX_TTS_VOICE=male-qn-qingse
MINIMAX_TTS_MODEL=speech-2.8-turbo

# ASR 配置
MINIMAX_ASR_MODEL=asr-1.0

# LLM 配置
MINIMAX_LLM_MODEL=abab6.5s-chat

# Server
PORT=3001
NODE_ENV=development
