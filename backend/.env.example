# === MiniMax voice model config ===
# Leave empty to enable mock fallback (the service still starts, but conversation / scoring / TTS
# return mock data — perfect for local front-end debugging without spending API credits).
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
API_BASE=https://api.minimax.chat

# === Server config ===
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info

# === CORS ===
# Comma-separated origins. Default is local Vite dev. Production override via env.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# === Content directory ===
# Where the static content (scenarios / dialogs / vocabulary / system prompts) lives.
# Defaults to /workspace/content — override if you keep content elsewhere.
CONTENT_DIR=/workspace/content
