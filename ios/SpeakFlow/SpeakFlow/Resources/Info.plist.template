<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  SpeakFlow iOS App Info.plist 模板
  Mac 上 Xcode 创建项目时直接 paste 进 Info.plist 或在 Capabilities 添加权限
-->
<plist version="1.0">
<dict>
    <key>CFBundleDisplayName</key>
    <string>SpeakFlow</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>

    <!-- iOS 17+ deployment target -->
    <key>MinimumOSVersion</key>
    <string>17.0</string>

    <!-- 必需权限：麦克风 + 语音识别（ASR 必填） -->
    <key>NSMicrophoneUsageDescription</key>
    <string>SpeakFlow 需要使用麦克风录音来练习英语口语</string>
    <key>NSSpeechRecognitionUsageDescription</key>
    <string>SpeakFlow 使用语音识别把您的英语发音转为文字，便于评分反馈</string>

    <!-- iOS 17+ 用 AVAudioApplication，旧版本 fallback 到 AVAudioSession -->
    <!-- iPhone 15 Pro + iOS 17+ 用 AVAudioApplication.requestRecordPermission -->

    <!-- 后端地址（与 SpeakFlowKit/APIClient.swift 保持一致） -->
    <!-- 允许 HTTP 明文仅开发用；生产 release 用 HTTPS -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <false/>
    </dict>

    <!-- Dynamic Island + Live Activity (Practice 录音状态显示) -->
    <key>NSSupportsLiveActivities</key>
    <true/>
    <key>NSSupportsLiveActivitiesFrequentUpdates</key>
    <true/>

    <!-- 启动屏 -->
    <key>UILaunchScreen</key>
    <dict>
        <key>UIColorName</key>
        <string></string>
    </dict>

    <!-- 设备方向：iPhone 全方向，iPad 视情况 -->
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>

    <!-- 后台模式：音频播放（朗读时可后台运行） -->
    <key>UIBackgroundModes</key>
    <array>
        <string>audio</string>
    </array>
</dict>
</plist>